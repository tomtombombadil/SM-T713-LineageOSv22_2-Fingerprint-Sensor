# Scripts run on Android/TWRP and must keep Unix line endings,
# even when the repository is checked out on Windows.
*.sh                text eol=lf
*.rc                text eol=lf
*.rule              text eol=lf
*.prop              text eol=lf
update-binary       text eol=lf
updater-script      text eol=lf
filelist.txt        text eol=lf
SHA256SUMS          text eol=lf
*.zip               binary
*.so                binary
src/flashable/files/bin/hw/*     binary
